<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <TextView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#590A3C6E"
            android:shadowDy="6"
            android:shadowRadius="1"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="60sp" />

        <ImageView
            android:layout_width="128dp"
            android:layout_height="132dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/mascote"
            android:src="@drawable/tico" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/slogan"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

        <Button
            android:id="@+id/entrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/botao_branco"
            android:minHeight="60dp"
            android:paddingHorizontal="28dp"
            android:stateListAnimator="@null"
            android:text="@string/entrar_google"
            android:textAllCaps="false"
            android:textColor="@color/tinta"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/dica_login"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mostrarServidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:text="@string/configurar_servidor"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/caixaServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cartao"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/endereco_api"
                android:textColor="@color/tinta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ajuda_servidor"
                android:textColor="@color/tinta_2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/servidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints="url"
                android:background="@drawable/campo"
                android:hint="@string/endereco_api"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tinta" />

            <Button
                android:id="@+id/salvarServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/botao_azul"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/salvar_testar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
